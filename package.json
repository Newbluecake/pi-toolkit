{
  "name": "pi-toolkit",
  "version": "0.2.1",
  "description": "Toolbox extension for pi — anti-hang subagents (Agent / get_subagent_result / steer_subagent), HUD footer, web_search failover, task tools, ask_user, bash auto-background, scheduler, message fabric, /goal loop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Newbluecake/pi-toolkit.git"
  },
  "homepage": "https://github.com/Newbluecake/pi-toolkit#readme",
  "bugs": "https://github.com/Newbluecake/pi-toolkit/issues",
  "files": [
    "index.js",
    "index.ts",
    "src",
    "skills",
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "subagent",
    "agent"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.87.0 <0.88.0",
    "@earendil-works/pi-coding-agent": ">=0.87.0 <0.88.0",
    "@earendil-works/pi-tui": ">=0.87.0 <0.88.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "~5.2.4",
    "@vue/test-utils": "^2.4.0",
    "axe-core": "^4.13.0",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vite": "~5.4.21",
    "vitest": "^2.1.0",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config src/web-hub/ui/vite.config.ts",
    "dev:web": "vite build --watch --config src/web-hub/ui/vite.config.ts",
    "check:web": "tsx scripts/web-hub/check-ui-dist.ts",
    "probe:csp": "tsx scripts/web-hub/csp-probe.ts",
    "dev:hub": "tsx scripts/web-hub/dev-hub.ts",
    "visual:web": "tsx scripts/web-hub/visual.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.typecheck.json && vue-tsc --noEmit -p src/web-hub/ui/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:conformance": "vitest run tests/conformance",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build && npm run build:web && npm run check:web"
  },
  "engines": {
    "node": ">=22"
  }
}
