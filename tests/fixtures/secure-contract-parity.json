        "PI_SECURE_SESSION": "1",
        "PI_SECURE_ORIG_ENV": "{\"TMPDIR\": \"/tmp\", \"ARMORY_MEMORY_ROOT\": null}"
      },
      "expect": {
        "PATH": "/usr/bin",
        "TMPDIR": "/tmp"
      }
    },
    {
